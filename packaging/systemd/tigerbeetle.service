[Unit]
Description=TigerBeetle ledger for garden
Documentation=https://github.com/tigerbeetle/tigerbeetle
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=garden
Group=garden
WorkingDirectory=/var/lib/garden
ExecStart=/opt/garden/bin/tigerbeetle start --addresses=127.0.0.1:3001 /var/lib/garden/0_0.tigerbeetle
Restart=always
RestartSec=1
LimitNOFILE=65536
# TigerBeetle keeps its cache resident and uses io_uring / O_DIRECT.
LimitMEMLOCK=infinity
AmbientCapabilities=CAP_IPC_LOCK
CapabilityBoundingSet=CAP_IPC_LOCK
PrivateTmp=true

[Install]
WantedBy=multi-user.target
